{
  "bean-core": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/rehydrate.py",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/git_guardrails.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/okf.py validate .scratch 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
